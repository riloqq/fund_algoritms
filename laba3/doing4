#include "laba2_41.c"
#include <stdlib.h>
#include <time.h>
#include <ctype.h>

typedef struct {
    String* city;
    String* street;
    unsigned int house_number;
    String* building;
    unsigned int apartment_number;
    String* postal_code;
} Address;

typedef struct {
    Address* recipient;
    float weight;
    String* postal_identifier;
    String* creation_time;
    String* delivery_time;
} Mail;

typedef struct {
    Address* current_post_office;
    Mail** mails;
    size_t mail_count;
} Post;

String* get_current_time_string();
int is_digits_only(const char *str);
int is_valid_time_format(const char* time_str);
int get_positive_int(const char* prompt);
Mail* create_mail(Post* post);
void delete_mail(Mail* mail);
void add_mail(Post* post);
void remove_mail(Post* post, char* identifier);
Mail* find_mail_by_identifier(Post* post, char* identifier);
void display_mails(Post* post);
void menu(Post* post);

String* get_current_time_string() {
    time_t rawtime;
    struct tm *timeinfo;
    char buffer[20];
    time(&rawtime);
    timeinfo = localtime(&rawtime);
    strftime(buffer, 20, "%d:%m:%Y %H:%M:%S", timeinfo);

    return create_string(buffer);
}

int is_digits_only(const char *str) {
    for (int i = 0; str[i] != '\0'; i++) {
        if (!isdigit(str[i])) {
            return 0;
        }
    }
    return 1;
}

int is_valid_time_format(const char* time_str) {
    if (strlen(time_str) != 19) {
        return 0;
    }
    if (time_str[2] != ':' || time_str[5] != ':' || time_str[10] != ' ' || time_str[13] != ':' || time_str[16] != ':') {
        return 0;
    }
    return is_digits_only(time_str) ? 1 : 0;
}

int get_positive_int(const char* prompt) {
    char buffer[BUFSIZ];
    int value;

    while (1) {
        printf("%s", prompt);
        scanf("%s", buffer);
        if (is_digits_only(buffer) && sscanf(buffer, "%d", &value) == 1 && value > 0) {
            return value;
        }
        printf("Ошибка: введите положительное целое число.\n");
    }
}

Mail* create_mail(Post* post) {
    Mail* mail = (Mail*) malloc(sizeof(Mail));
    if (!mail) {
        return NULL;
    }

    Address* temp = (Address*) malloc(sizeof(Address));
    if (!temp) {
        free(mail);
        return NULL;
    }
    mail->recipient = temp;
    char buffer[BUFSIZ];

    printf("Введите город получателя: ");
    scanf("%s", buffer);
    mail->recipient->city = create_string(buffer);
    if (!mail->recipient->city) {
        free(temp);
        free(mail);
        return NULL;
    }

    printf("Введите улицу получателя: ");
    scanf("%s", buffer);
    mail->recipient->street = create_string(buffer);
    if (!mail->recipient->street) {
        delete_string(mail->recipient->city);
        free(temp);
        free(mail);
        return NULL;
    }

    mail->recipient->house_number = get_positive_int("Введите номер дома (натуральное число): ");

    printf("Введите корпус: ");
    scanf("%s", buffer);
    mail->recipient->building = create_string(buffer);
    if (!mail->recipient->building) {
        delete_string(mail->recipient->street);
        delete_string(mail->recipient->city);
        free(temp);
        free(mail);
        return NULL;
    }

    mail->recipient->apartment_number = get_positive_int("Введите номер квартиры (натуральное число): ");

    do {
        printf("Введите индекс получателя (6 цифр): ");
        scanf("%s", buffer);
        if (strlen(buffer) != 6 || !is_digits_only(buffer)) {
            printf("Ошибка: индекс должен содержать ровно 6 цифр.\n");
        }
    } while (strlen(buffer) != 6 || !is_digits_only(buffer));
    mail->recipient->postal_code = create_string(buffer);
    if (!mail->recipient->postal_code) {
        delete_string(mail->recipient->building);
        delete_string(mail->recipient->street);
        delete_string(mail->recipient->city);
        free(temp);
        free(mail);
        return NULL;
    }

    float weight;
    do {
        printf("Введите вес посылки (положительное число): ");
        if (scanf("%f", &weight) != 1 || weight <= 0) {
            printf("Ошибка: вес должен быть положительным числом.\n");
            while (getchar() != '\n');
        } else {
            break;
        }
    } while (1);
    mail->weight = weight;

    do {
        printf("Введите почтовый идентификатор (14 цифр): ");
        scanf("%99s", buffer);
        if (strlen(buffer) != 14 || !is_digits_only(buffer)) {
            printf("Ошибка: почтовый идентификатор должен содержать ровно 14 цифр.\n");
            continue;
        }
        if (find_mail_by_identifier(post, buffer) != NULL) {
            printf("Ошибка: почтовый идентификатор уже используется.\n");
        } else {
            break;
        }
    } while (1);
    mail->postal_identifier = create_string(buffer);
    if (!mail->postal_identifier) {
        delete_string(mail->recipient->postal_code);
        delete_string(mail->recipient->building);
        delete_string(mail->recipient->street);
        delete_string(mail->recipient->city);
        free(temp);
        free(mail);
        return NULL;
    }

    mail->creation_time = get_current_time_string();
    if (!mail->creation_time) {
        delete_string(mail->postal_identifier);
        delete_string(mail->recipient->postal_code);
        delete_string(mail->recipient->building);
        delete_string(mail->recipient->street);
        delete_string(mail->recipient->city);
        free(temp);
        free(mail);
        return NULL;
    }

    char buf[20];
    printf("Введите время доставки (в формате дд:мм:гггг чч:мм:сс): ");
    scanf("%19s", buffer);
    while (!is_valid_time_format(buffer)) {
        printf("Ошибка: неверный формат. Повторите ввод (дд:мм:гггг чч:мм:сс): ");
        scanf("%19s", buffer);
    }
    mail->delivery_time = create_string(buffer);

    return mail;
}

void delete_mail(Mail* mail) {
    if (!mail) {
        return;
    }
    delete_string(mail->recipient->city);
    delete_string(mail->recipient->street);
    delete_string(mail->recipient->building);
    delete_string(mail->recipient->postal_code);

    delete_string(mail->postal_identifier);
    delete_string(mail->creation_time);

    if (mail->delivery_time) {
        delete_string(mail->delivery_time);
    }

    free(mail->recipient);
    free(mail);
}

void add_mail(Post* post) {
    Mail* new_mail = create_mail(post);
    if (!new_mail) {
        return;
    }
    post->mail_count++;
    Mail** temp = (Mail**) realloc(post->mails,post->mail_count * sizeof(Mail*));
    if (!temp) {
        return;
    }
    post->mails = temp;
    post->mails[post->mail_count - 1] = new_mail;
}

void remove_mail(Post* post, char* identifier) {
    size_t temp;
    for (size_t i = 0; i < post->mail_count; i++) {
        if (strcmp(post->mails[i]->postal_identifier->arr, identifier) == 0) {
            delete_mail(post->mails[i]);
            temp = i;
        }
    }
    for (temp; temp < post->mail_count - 1; temp++) {
        post->mails[temp] = post->mails[temp + 1];
    }
    post->mail_count--;
    Mail** temp1 = (Mail**) realloc(post->mails, post->mail_count * sizeof(Mail*));
    if (!temp) {
        return;
    }
    post->mails = temp1;
}

Mail* find_mail_by_identifier(Post* post, char* identifier) {
    for (size_t i = 0; i < post->mail_count; i++) {
        if (strcmp(post->mails[i]->postal_identifier->arr, identifier) == 0) {
            return post->mails[i];
        }
    }
    return NULL;
}

void display_mails(Post* post) {
    printf("\nСписок посылок:\n");
    for (size_t i = 0; i < post->mail_count; i++) {
        Mail* mail = post->mails[i];
        printf("Идентификатор: %s\n", mail->postal_identifier->arr);
        printf("Город: %s\n", mail->recipient->city->arr);
        printf("Улица: %s\n", mail->recipient->street->arr);
        printf("Номер дома: %u\n", mail->recipient->house_number);
        printf("Корпус: %s\n", mail->recipient->building->arr);
        printf("Номер квартиры: %u\n", mail->recipient->apartment_number);
        printf("Почтовый индекс: %s\n", mail->recipient->postal_code->arr);
        printf("Вес: %.2f кг\n", mail->weight);
        printf("Время создания: %s\n", mail->creation_time->arr);
        if (mail->delivery_time) {
            printf("Время доставки: %s\n", mail->delivery_time->arr);
        } else {
            printf("Время доставки: ещё не установлено\n");
        }
        printf("\n");
    }
}

void menu(Post* post) {
    int choice;
    while (1) {
        printf("\nВыберите действие:\n");
        printf("1. Добавить посылку\n");
        printf("2. Удалить посылку\n");
        printf("3. Найти посылку по идентификатору\n");
        printf("4. Показать все посылки\n");
        printf("5. Выйти\n");
        printf("Введите номер действия: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                add_mail(post);
                break;
            case 2:
                char id[15];
                printf("Введите индекс посылки для удаления: ");
                scanf("%s", id);
                remove_mail(post, id);
                break;
            case 3:
                char identifier[15];
                printf("Введите идентификатор посылки: ");
                scanf("%s", identifier);
                Mail *mail = find_mail_by_identifier(post, identifier);
                if (mail) {
                    printf("Посылка найдена: Город: %s, Улица: %s, Вес: %.2f\n",
                           mail->recipient->city->arr, mail->recipient->street->arr, mail->weight);
                } else {
                    printf("Посылка не найдена.\n");
                }
                break;
            case 4:
                display_mails(post);
                break;
            case 5:
                return;
            default:
                printf("Некорректный выбор.\n");
                break;
        }
    }
}

int main(){
    Post post_office = {NULL, NULL, 0};
    menu(&post_office);

    for (size_t i = 0; i < post_office.mail_count; i++) {
        delete_mail(post_office.mails[i]);
    }
    free(post_office.mails);
    return 0;

}
