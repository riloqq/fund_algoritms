int parse_time(String* time_str, struct tm* time_struct) {
    if (!time_str || !time_str->arr) {
        return 0;
    }
    *time_struct = (struct tm){0};
    if (sscanf(time_str->arr, "%2d:%2d:%4d %2d:%2d:%2d",
               &time_struct->tm_mday,
               &time_struct->tm_mon,
               &time_struct->tm_year,
               &time_struct->tm_hour,
               &time_struct->tm_min,
               &time_struct->tm_sec) != 6) {
        return 0;
    }

    time_struct->tm_mon -= 1;
    time_struct->tm_year -= 1900;

    return 1;
}

int cmp1_mail(const void* a, const void* b) {
    Mail* mail1 = *(Mail**)a;
    Mail* mail2 = *(Mail**)b;
    int res = compare_strings(mail1->recipient->postal_code, mail2->recipient->postal_code);
    if (res != 0) {
        return res;
    }
    return compare_strings(mail1->postal_identifier, mail2->postal_identifier);
}

int cmp2_mail(const void* a, const void* b) {
    const Mail* mail1 = (const Mail*)a;
    const Mail* mail2 = (const Mail*)b;

    struct tm t1, t2;
    if (!parse_time(mail1->creation_time, &t1) || !parse_time(mail2->creation_time, &t2)) {
        return 0;
    }

    time_t time1 = mktime(&t1);
    time_t time2 = mktime(&t2);

    return (time1 > time2) - (time1 < time2);
}

void sort_mails(Post* post) {
    qsort(post->mails, post->mail_count, sizeof(Mail*), cmp1_mail);
}

int is_expired(const Mail* mail, time_t current_time) {
    struct tm delivery_time;
    if (!parse_time(mail->delivery_time, &delivery_time)) {
        return 0;
    }

    time_t delivery_epoch = mktime(&delivery_time);
    return current_time > delivery_epoch;
}

void show_delivered_mails(Post *post) {
    time_t current_time;
    time(&current_time);

    printf("Список доставленных посылок:\n");

    Mail* delivered_mails[post->mail_count];
    size_t delivered_count = 0;

    for (size_t i = 0; i < post->mail_count; i++) {
        Mail *mail = post->mails[i];

        struct tm delivery_time_tm, creation_time_tm;
        if (!parse_time(mail->delivery_time, &delivery_time_tm) ||
            !parse_time(mail->creation_time, &creation_time_tm)) {
            printf("Ошибка в формате времени доставки для идентификатора %s\n", mail->postal_identifier->arr);
            continue;
        }

        time_t delivery_time = mktime(&delivery_time_tm);
        time_t creation_time = mktime(&creation_time_tm);

        if (difftime(delivery_time, creation_time) > 0 && difftime(current_time, delivery_time) >= 0) {
            delivered_mails[delivered_count++] = mail;
        }
    }

    qsort(delivered_mails, delivered_count, sizeof(Mail*), cmp2_mail);


    for (size_t i = 0; i < delivered_count; i++) {
        Mail *mail = delivered_mails[i];
        printf("Индекс: %s, Улица: %s, Дом: %u, Идентификатор: %s, Время доставки: %s\n",
               mail->recipient->postal_code->arr,
               mail->recipient->street->arr,
               mail->recipient->house_number,
               mail->postal_identifier->arr,
               mail->delivery_time->arr);
    }
}

void show_undelivered_mails(Post *post) {
    time_t current_time;
    time(&current_time);

    printf("Список недоставленных посылок:\n");

    Mail* undelivered_mails[post->mail_count];
    size_t undelivered_count = 0;

    for (size_t i = 0; i < post->mail_count; i++) {
        Mail *mail = post->mails[i];

        if (!is_expired(mail, current_time)) {
            struct tm creation_time;
            if (!parse_time(mail->creation_time, &creation_time)) {
                printf("Ошибка в формате времени создания для идентификатора %s\n", mail->postal_identifier->arr);
                continue;
            }

            time_t creation_epoch = mktime(&creation_time);
            if (difftime(current_time, creation_epoch) > 0) {
                undelivered_mails[undelivered_count++] = mail;
            }
        }
    }

    qsort(undelivered_mails, undelivered_count, sizeof(Mail*), cmp2_mail);

    for (size_t i = 0; i < undelivered_count; i++) {
        Mail *mail = undelivered_mails[i];
        printf("Индекс: %s, Улица: %s, Дом: %u, Идентификатор: %s, Время создания: %s\n",
               mail->recipient->postal_code->arr,
               mail->recipient->street->arr,
               mail->recipient->house_number,
               mail->postal_identifier->arr,
               mail->delivery_time->arr);
    }
}

status menu(Post* post) {
    int choice;
    int err;
    char* buf = NULL;
    time_t current_time = time(NULL);

    while (1) {
        printf("\nВыберите действие:\n");
        printf("1. Добавить посылку\n");
        printf("2. Удалить посылку\n");
        printf("3. Найти посылку по идентификатору\n");
        printf("4. Показать все посылки\n");
        printf("5. Проверить истекшие посылки\n");
        printf("6. Показать доставленные посылки\n");
        printf("7. Показать недоставленные посылки\n");
        printf("8. Выйти\n");
        printf("Введите номер действия: ");

        err = read_line(&buf);
        if (!err) {
            choice = atoi(buf);
            free(buf);
        }

        switch (choice) {
            case 1:
                int stat = add_mail(post);
                if (stat != SUCCESS) {
                    return stat;
                }
                break;
            case 2:
                char id[15];
                printf("Введите индекс посылки для удаления: ");
                scanf("%s", id);
                remove_mail(post, id);
                break;
            case 3:
                char identifier[15];
                printf("Введите идентификатор посылки: ");
                scanf("%s", identifier);
                Mail *mail = find_mail_by_identifier(post, identifier);
                if (mail) {
                    printf("Посылка найдена: Город: %s, Улица: %s, Вес: %.2f\n",
                           mail->recipient->city->arr, mail->recipient->street->arr, mail->weight);
                } else {
                    printf("Посылка не найдена.\n");
                }
                break;
            case 4:
                display_mails(post);
                break;
            case 5:
                printf("Истекшие посылки:\n");
                for (size_t i = 0; i < post->mail_count; i++) {
                    if (is_expired(post->mails[i], current_time)) {
                        printf("Индекс: %s, Улица: %s, Дом: %u, Идентификатор: %s, Время создания: %s\n",
                               post->mails[i]->recipient->postal_code->arr,
                               post->mails[i]->recipient->street->arr,
                               post->mails[i]->recipient->house_number,
                               post->mails[i]->postal_identifier->arr,
                               post->mails[i]->delivery_time->arr);
                    }
                }
                break;
            case 6:
                show_delivered_mails(post);
                break;
            case 7:
                show_undelivered_mails(post);
                break;
            case 8:
                return SUCCESS;
            default:
                printf("Некорректный выбор.\n");
                break;
        }
    }
}

