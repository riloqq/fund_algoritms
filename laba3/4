String* get_current_time_string() {
    time_t rawtime;
    struct tm *timeinfo;
    char buffer[20];
    time(&rawtime);
    timeinfo = localtime(&rawtime);
    strftime(buffer, 20, "%d:%m:%Y %H:%M:%S", timeinfo);

    return create_string(buffer);
}

int read_line(char **result) {
    int buffer_size = 16;
    int length = 0;
    char *buffer = calloc(buffer_size, sizeof(char));

    if (!buffer) {
        return -1;
    }

    int ch;
    while ((ch = fgetc(stdin)) != '\n' && ch != EOF) {
        if (length + 1 >= buffer_size) {
            buffer_size *= 2;
            char *new_buffer = realloc(buffer, buffer_size);
            if (!new_buffer) {
                free(buffer);
                return -1;
            }
            buffer = new_buffer;
        }
        buffer[length++] = ch;
    }

    buffer[length] = '\0';
    *result = buffer;

    if (ch != '\n' && ch != EOF) {
        while ((ch = fgetc(stdin)) != '\n' && ch != EOF);
    }

    return 0;
}

int is_digits_only(const char *str) {
    for (int i = 0; str[i] != '\0'; i++) {
        if (!isdigit(str[i])) {
            return 0;
        }
    }
    return 1;
}

int is_valid_time_format(const char* time_str) {
    if (strlen(time_str) != 19) {
        return 0;
    }

    if (time_str[2] != ':' || time_str[5] != ':' || time_str[10] != ' ' || time_str[13] != ':' || time_str[16] != ':') {
        return 0;
    }
    int day = (time_str[0] - '0') * 10 + (time_str[1] - '0');
    int month = (time_str[3] - '0') * 10 + (time_str[4] - '0');
    int year = (time_str[6] - '0') * 1000 + (time_str[7] - '0') * 100 + (time_str[8] - '0') * 10 + (time_str[9] - '0');
    int hour = (time_str[11] - '0') * 10 + (time_str[12] - '0');
    int minute = (time_str[14] - '0') * 10 + (time_str[15] - '0');
    int second = (time_str[17] - '0') * 10 + (time_str[18] - '0');
    if (day < 1 || day > 31 || month < 1 || month > 12 || year < 0 ||
        hour > 23 || minute > 59 || second > 59) {
        return 0;
    }
    return 1;
}

