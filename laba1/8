#include <stdlib.h>
#include <stdio.h>
#include <string.h>
#include <ctype.h>

typedef enum {
    ERR_STDIN_FALL = -3,
    ERR_INCORRECT_BASE = -2,
    ERR_INVALID_SYM = -1,
    SUCCESS = 0,
    ERR_INVALID_ARGS = 1,
    ERR_OPENING_FILES = 2
} status;

int find_min_base(const char* num_str);
long long convert_to_decimal(const char* num_str, int base);

int find_min_base(const char* num_str){
    int min_base = 2;
    for (int i = 0; num_str[i] != '\0'; i++){
        if (isdigit(num_str[i])) {
            int digit = num_str[i] - '0';
            if (digit >= min_base) {
                min_base = digit + 1;
            }
        } else if (isalpha(num_str[i])){
            int digit = toupper(num_str[i]) - 'A' + 10;
            if (digit >= min_base){
                min_base = digit + 1;
            }
        }
    }
    return (min_base > 36) ? ERR_INCORRECT_BASE : min_base;
}

long long convert_to_decimal(const char* num_str, int base) {
    long long result = 0;
    int sign = 1;
    int start_index = 0;

    if (num_str[0] == '-') {
        sign = -1;
        start_index = 1;
    }

    for (int i = start_index; num_str[i] != '\0'; i++) {
        int digit;
        if (isdigit(num_str[i])) {
            digit = num_str[i] - '0';
        } else if (isalpha(num_str[i])) {
            digit = toupper(num_str[i]) - 'A' + 10;
        } else {
            return ERR_INVALID_SYM;
        }
        result = result * base + digit;
    }
    return sign * result;
}

int main(int argc, char *argv[]) {
    if (argc != 3) {
        return ERR_INVALID_ARGS;
    }

    FILE *input_file = fopen(argv[1], "r");
    FILE *output_file = fopen(argv[2], "w");

    if (!input_file || !output_file) {
        if (input_file) {
            fclose(input_file);
        }
        if (output_file) {
            fclose(output_file);
        }
        return ERR_OPENING_FILES;
    }

    char line[BUFSIZ];
    while (fgets(line, sizeof(line), input_file)) {
        char *token = strtok(line, " \t\n/r");
        while (token != NULL) {
            int min_base = find_min_base(token);
            if (min_base == -2) {
                fprintf(output_file, "Ошибка: недопустимое число '%s'.\n", token);
            } else {
                long long decimal_value = convert_to_decimal(token, min_base);
                fprintf(output_file, "Число: %s, минимальная база: %d, в десятичной: %lld\n",
                        token, min_base, decimal_value);
            }
            token = strtok(NULL, " \t\n/r");
        }
    }

    fclose(input_file);
    fclose(output_file);

    return SUCCESS;
}
