#include <stdio.h>
#include <stdlib.h>
#include <stdarg.h>

typedef enum {
    SUCCESS = 0,
    ERR_OPENING_FILE = 2,
    ERR_EMPTY_SUBSTR = 3,
    MEMORY_ALLOCATION_ERROR = 4
} status;

int get_len(const char* str) {
    int len = 0;
    for (int i = 0; str[i]; i++) {
        len++;
    }
    return len;
}

int compare_strings(const char* str1, const char* str2){
    while (*str2 != '\0'){
        if (*str1 != *str2) return 0;
        str1++;
        str2++;
    }
    return 1;
}

status find_str(const char* file_name, const char* str, char*** out_strings) {
    FILE *file = fopen(file_name,"r");
    if (!file) {
        return ERR_OPENING_FILE;
    }
    int mem_size = 40;
    char **out_msg = (char**) malloc(sizeof(char*) * (mem_size));
    if (!out_msg) {
        fclose(file);
        return MEMORY_ALLOCATION_ERROR;
    }
    int count = 0;

    fseek(file, 0, SEEK_END);
    long int file_size = ftell(file);
    fseek(file, 0, SEEK_SET);

    char* buffer = (char*) malloc(file_size + sizeof(char));
    if (!buffer) {
        fclose(file);
        free(out_msg);
        return MEMORY_ALLOCATION_ERROR;
    }

    fread(buffer, 1, file_size, file);
    buffer[file_size] = '\0';

    int line_index = 1;
    int chars_in_line = 1;
    int str_len = get_len(str);

    for (int i = 0; i <= file_size - str_len; i++) {
        if (compare_strings(&buffer[i], str)) {
            char* msg = (char*) malloc(sizeof(char) * 40);
            if (!msg) {
                fclose(file);
                for (int j = 0; j < count; j++) {
                    free(out_msg[j]);
                }
                free(out_msg);
                free(buffer);
                return MEMORY_ALLOCATION_ERROR;
            }
            sprintf(msg, "Файл: %s, строка: %d, cимвол: %d", file_name, line_index, chars_in_line);
            if (mem_size <= (count + 1)) {
                mem_size *= 2;
                char** temp = (char**) realloc(out_msg, sizeof(char*) * mem_size);
                if (!temp) {
                    fclose(file);
                    for (int j = 0; j < count; j++) {
                        free(out_msg[j]);
                    }
                    free(out_msg);
                    free(buffer);
                    return MEMORY_ALLOCATION_ERROR;
                }
                out_msg = temp;
            }
            out_msg[count] = msg;
            count++;
        }
        if (buffer[i] == '\n') {
            line_index++;
            chars_in_line = 1;
        } else {
            chars_in_line++;
        }
    }
    out_msg[count] = NULL;

    fclose(file);
    free(buffer);
    *out_strings = out_msg;

    return SUCCESS;
}

status find_str_in_files(const char* str, char*** result, const int n, ...) {
    if (get_len(str) <= 0) {
        return ERR_EMPTY_SUBSTR;
    }

    int mem_size = 40;
    int cnt = 0;
    char **out_msg = (char**) malloc(sizeof(char*) * mem_size);
    if (!out_msg) {
        return MEMORY_ALLOCATION_ERROR;
    }

    va_list list;
    va_start(list, n);
    for (int i = 0; i < n; i++) {
        char* file_name = va_arg(list, char*);

        char** msgs;
        status err = find_str(file_name, str, &msgs);
        if (err) {
            for (int k = 0; k < cnt; k++) {
                free(out_msg[k]);
            }
            free(out_msg);
            va_end(list);
            return err;
        }
        for (int j = 0; msgs[j]; j++) {
            if (cnt + 1 >= mem_size) {
                mem_size *= 2;
                char** temp = (char**) realloc(out_msg, sizeof(char*) * mem_size);
                if (!temp) {
                    for (int k = 0; k < cnt; k++) {
                        free(out_msg[k]);
                    }
                    free(out_msg);
                    va_end(list);
                    return MEMORY_ALLOCATION_ERROR;
                }
                out_msg = temp;
            }
            out_msg[cnt++] = msgs[j];
        }
        free(msgs);
    }
    va_end(list);
    out_msg[cnt] = NULL;

    *result = out_msg;
    return SUCCESS;
}

int main(int argc, char** argv) {
    char** result;
    status err = find_str_in_files("\nq", &result, 1, "file1.txt");
    if (err) {
        return err;
    }
    for (int i = 0; result[i]; i++) {
        printf("%s\n", result[i]);
        free(result[i]);
    }
    free(result);

    return err;
}
