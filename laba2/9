#include <stdio.h>
#include <stdlib.h>
#include <stdarg.h>
#include <math.h>
#include <limits.h>

typedef enum {
    SUCCESS = 0,
    ERR_INVALID_BASE = 2,
    ERR_OVERFLOW = 3
} status;

int gcd(int a, int b);
void reduce(int *numerator, int *denominator);
int prod_prime_devisors(int number);
int is_prime(long int number);
int validate_denominator(double x, int *numerator, int *denominator);

int gcd(int a, int b) {
    while (b != 0) {
        int temp = b;
        b = a % b;
        a = temp;
    }
    return a;
}

void reduce(int *numerator, int *denominator) {
    int divisor = gcd(*numerator, *denominator);
    *numerator /= divisor;
    *denominator /= divisor;
}

int prod_prime_devisors(int number) {
    if (number < 2) return 1;
    int product = 1;
    for (int i = 2; i <= number; i++) {
        if (number % i == 0 && is_prime(i)) {
            if (product > INT_MAX / i) {
                return ERR_OVERFLOW;
            }
            product *= i;
            while (number % i == 0) {
                number /= i;
            }
        }
    }
    return product;
}

int is_prime(long int number) {
    if (number < 2) return 0;
    for (int k = 2; k * k <= number; k++) {
        if (number % k == 0) {
            return 0;
        }
    }
    return 1;
}

int validate_denominator(double x, int *numerator, int *denominator) {
    *numerator = 1;
    *denominator = (int)round(1.0 / x);

    double eps = 0.00001;
    double approximation = (double)*numerator / *denominator;
    double difference = approximation - x;

    while (fabs(difference) >= eps) {
        int diffDenominator;
        if (difference > 0) {
            diffDenominator = (int)round(1.0 / difference);
            int newNumerator = *numerator * diffDenominator - *denominator;

            if (newNumerator > INT_MAX || newNumerator < INT_MIN) {
                return ERR_OVERFLOW;
            }
            int newDenominator = *denominator * diffDenominator;

            if (newDenominator > INT_MAX || newDenominator < INT_MIN) {
                return ERR_OVERFLOW;
            }
            *numerator = newNumerator;
            *denominator = newDenominator;
        } else {
            diffDenominator = (int)round(1.0 / -difference);
            int newNumerator = *numerator * diffDenominator + *denominator;

            if (newNumerator > INT_MAX || newNumerator < INT_MIN) {
                return ERR_OVERFLOW;
            }
            int newDenominator = *denominator * diffDenominator;

            if (newDenominator > INT_MAX || newDenominator < INT_MIN) {
                return ERR_OVERFLOW;
            }
            *numerator = newNumerator;
            *denominator = newDenominator;
        }

        approximation = (double)*numerator / *denominator;
        difference = approximation - x;
    }
    reduce(numerator, denominator);
    return SUCCESS;
}

int has_finite_representation(double value, int base) {
    if (isinf(value) || isnan(value)) {
        return 0;
    }

    if (value == 0.0) {
        return 1;
    }

    int numerator, denominator;
    int validation_result = validate_denominator(value, &numerator, &denominator);
    if (validation_result == ERR_OVERFLOW) {
        return ERR_OVERFLOW;
    }

    int prod = prod_prime_devisors(denominator);
    if (prod == ERR_OVERFLOW) {
        return ERR_OVERFLOW;
    }

    return (base % prod == 0);
}

int check_finite_representation(int base, int count, ...) {
    va_list args;
    va_start(args, count);

    for (int i = 0; i < count; i++) {
        double value = va_arg(args, double);
        int result = has_finite_representation(value, base);
        if (result == ERR_OVERFLOW) {
            printf("Ошибка: переполнение при обработке числа %f.\n", value);
            va_end(args);
            return ERR_OVERFLOW;
        }
        if (result) {
            printf("Число %f имеет конечное представление в системе с основанием %d.\n", value, base);
        } else {
            printf("Число %f не имеет конечного представления в системе с основанием %d.\n", value, base);
        }
    }
    va_end(args);
    return SUCCESS;
}

int main() {
    char base_input[10];
    int base;

    printf("Введите основание системы счисления (от 2): ");
    scanf("%9s", base_input);

    char *end_ptr;
    long base_l = strtol(base_input, &end_ptr, 10);

    if (*end_ptr != '\0' || base_l < 2 || base_l > INT_MAX) {
        printf("Недопустимое основание системы счисления.\n");
        return ERR_INVALID_BASE;
    }

    base = (int)base_l;

    if (check_finite_representation(base, 3, 0.17, 1.0/17.0, 1.0/5.0) == ERR_OVERFLOW) {
        return ERR_OVERFLOW;
    }

    return SUCCESS;
}
